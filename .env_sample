# Environment Configuration Sample
NODE_ENV=development
PORT=8080

# Database Settings
MONGODB_URL=mongodb://localhost:27017/ultimate_health_dev
BASE_URL=http://localhost:8080

# RS256 Asymmetric JWT Keys (Preferred for RS256 signing/verification)
# Convert private.pem and public.pem to single-line strings replacing newlines with \n
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Fallback HS256 JWT Secrets (Used if RS256 keys are not set)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_VERIFICATION_SECRET=your_jwt_verification_secret_here

# JWT Expiration Times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_VERIFICATION_EXPIRY=1h

# Token Hashing Secret (for OTP / Reset tokens)
TOKEN_SECRET=your_token_secret_here

# Redis Cache & Token Session Tracking
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / SMTP Settings
SMTP_HOST=smtp.example.com
EMAIL_USER=noreply@example.com
EMAIL_PASS=your_email_password_here

# Object Storage (Vultr / S3 Compatible)
VULTR_ACCESS_KEY=your_access_key_here
VULTR_SECRET_KEY=your_secret_key_here
BUCKET_NAME=ultimatehealth-bucket
ENDPOINT_URL=https://s3.example.com

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Gemini AI API Keys
GEMINI_API_KEY_1=your_gemini_api_key_here